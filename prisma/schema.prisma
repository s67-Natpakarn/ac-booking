generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model SystemSetting {
  id               String   @id @default("singleton")
  hasActiveSession Boolean  @default(false)
  sessionTitle     String   @default("BPS AC Cleaning Booking Schedule")
  uploadedFilename String?
  updatedAt        DateTime @updatedAt
}

model CleaningDate {
  id          String     @id @default(cuid())
  dateString  String     @unique // e.g. "2026-09-07"
  displayDate String     // e.g. "Monday, Sep 07, 2026"
  createdAt   DateTime   @default(now())
  rooms       Room[]
  timeSlots   TimeSlot[]
}

model Room {
  id             String       @id @default(cuid())
  roomNumber     String       // e.g. "39/92"
  floor          String       // e.g. "1st" or "1"
  cleaningDateId String
  cleaningDate   CleaningDate @relation(fields: [cleaningDateId], references: [id], onDelete: Cascade)
  isBooked       Boolean      @default(false)
  booking        Booking?
  createdAt      DateTime     @default(now())

  @@unique([roomNumber, cleaningDateId])
}

model TimeSlot {
  id             String       @id @default(cuid())
  cleaningDateId String
  cleaningDate   CleaningDate @relation(fields: [cleaningDateId], references: [id], onDelete: Cascade)
  timeSlot       String       // e.g. "09:30"
  isBooked       Boolean      @default(false)
  bookings       Booking[]
  createdAt      DateTime     @default(now())

  @@unique([cleaningDateId, timeSlot])
}

model Booking {
  id              String   @id @default(cuid())
  roomId          String   @unique
  room            Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  timeSlotId      String
  timeSlot        TimeSlot @relation(fields: [timeSlotId], references: [id], onDelete: Cascade)
  roomNumber      String
  floor           String
  dateString      String
  timeString      String
  staffAssistance Boolean  @default(false)
  createdAt       DateTime @default(now())
}
